{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "KandyTourism": "Server=(localdb)\\MSSQLLocalDB;Database=KandyTourism;Trusted_Connection=True;MultipleActiveResultSets=False;TrustServerCertificate=True"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "SeedOnStartup": false
  },
  "Jwt": {
    "Issuer": "kandy-tourism-api",
    "Audience": "kandy-tourism-admin",
    "AccessTokenMinutes": 60
  },
  "RateLimiting": {
    "LoginPermitLimit": 5
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
